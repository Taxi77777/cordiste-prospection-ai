# =========================================================================
#  Cordiste Prospection AI — configuration
#  Copiez ce fichier en « .env » puis renseignez vos valeurs.
#  Le fichier .env n'est JAMAIS versionné sur GitHub (voir .gitignore).
# =========================================================================

# ---- Envoi des rapports par email (hébergement LWS) ---------------------
SMTP_HOST=mail.cordiste-ile-de-france.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@cordiste-ile-de-france.fr
SMTP_PASSWORD=
# Serveur SMTP de secours (basculé automatiquement en cas d'échec)
SMTP_HOST_BACKUP=mail01.lwspanel.com

# Destinataire du rapport quotidien
REPORT_RECIPIENT=contact@cordiste-ile-de-france.fr
REPORT_SENDER_NAME=Cordiste Prospection AI

# ---- Base de données ----------------------------------------------------
# SQLite par défaut (aucune config). PostgreSQL possible, ex :
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/cordiste
# DATABASE_URL=sqlite:///data/prospects.db

# ---- Planification de la recherche automatique --------------------------
ENABLE_SCHEDULER=true
DAILY_HOUR=7
DAILY_MINUTE=30

# ---- Paramètres de recherche -------------------------------------------
DEPARTEMENTS=75,77,78,91,92,93,94,95
ONLY_ACTIVE=true
MAX_PAGES_PER_QUERY=2
PER_PAGE=25
REQUEST_TIMEOUT=30

# ---- IA (optionnelle, open source & gratuite via Ollama) ----------------
# Activez pour un scoring intelligent + justification, un message de
# prospection personnalisé et un résumé IA dans le rapport quotidien.
# Ollama (https://ollama.com) fait tourner des modèles open source en local,
# sans coût à l'usage. Avec Docker Compose, le service "ollama" est inclus.
AI_ENABLED=false
AI_BASE_URL=http://localhost:11434/v1
# Modèle open source à utiliser (ex : qwen2.5:3b, gemma3:4b, llama3.2:3b, phi4-mini).
# Petit modèle = tourne sur CPU. À télécharger une fois : `ollama pull qwen2.5:3b`
AI_MODEL=qwen2.5:3b
# Ollama ignore la clé. À renseigner seulement pour un service compatible OpenAI
# hébergé (Groq, OpenRouter, etc.) — dans ce cas, changez aussi AI_BASE_URL.
AI_API_KEY=ollama
AI_TIMEOUT=60
