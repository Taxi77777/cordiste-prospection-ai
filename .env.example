# =========================================================================
#  Cordiste Prospection AI — configuration
#  Copiez ce fichier en « .env » puis renseignez vos valeurs.
#  Le fichier .env n'est JAMAIS versionné sur GitHub (voir .gitignore).
# =========================================================================

# ---- Envoi des rapports par email (hébergement LWS) ---------------------
SMTP_HOST=mail.cordiste-ile-de-france.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@cordiste-ile-de-france.fr
SMTP_PASSWORD=
# Serveur SMTP de secours (basculé automatiquement en cas d'échec)
SMTP_HOST_BACKUP=mail01.lwspanel.com

# Destinataire du rapport quotidien
REPORT_RECIPIENT=contact@cordiste-ile-de-france.fr
REPORT_SENDER_NAME=Cordiste Prospection AI

# ---- Base de données ----------------------------------------------------
# SQLite par défaut (aucune config). PostgreSQL possible, ex :
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/cordiste
# DATABASE_URL=sqlite:///data/prospects.db

# ---- Planification de la recherche automatique --------------------------
ENABLE_SCHEDULER=true
DAILY_HOUR=7
DAILY_MINUTE=30

# ---- Paramètres de recherche -------------------------------------------
DEPARTEMENTS=75,77,78,91,92,93,94,95
ONLY_ACTIVE=true
MAX_PAGES_PER_QUERY=2
PER_PAGE=25
REQUEST_TIMEOUT=30
